{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "antd/locale/zh_CN": ["./vendor/antd-locale.ts"],
      "antd": ["./vendor/antd.tsx"],
      "@ant-design/pro-components": ["./vendor/pro-components.tsx"],
      "@ant-design/icons": ["./vendor/icons.tsx"],
      "@tanstack/react-query": ["./vendor/react-query.tsx"],
      "echarts-for-react": ["./vendor/echarts-react.tsx"],
      "echarts": ["./vendor/echarts.ts"],
      "react-router-dom": ["./vendor/react-router-dom.tsx"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
