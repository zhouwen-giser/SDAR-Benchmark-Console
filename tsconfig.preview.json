{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "product/src/**/*.ts",
    "product/src/**/*.tsx",
    "vendor/**/*.ts",
    "vendor/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "product/src/**/*.test.ts",
    "product/src/**/*.test.tsx",
    "product/src/test/**",
    "product/src/main.tsx",
    "product/src/api/generated/**",
    "product/src/mocks/browser.ts",
    "product/src/mocks/handlers.ts"
  ]
}
