FROM node:22-alpine AS build
WORKDIR /workspace/product
ENV CI=true
RUN corepack enable
COPY product/package.json product/pnpm-lock.yaml product/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY product/ ./
ARG VITE_API_MODE=http
ARG VITE_BENCHMARK_API_BASE_URL=/benchmark-api
ARG VITE_TELEMETRY_QUERY_BASE_URL=/telemetry-api
ENV VITE_API_MODE=$VITE_API_MODE \
    VITE_BENCHMARK_API_BASE_URL=$VITE_BENCHMARK_API_BASE_URL \
    VITE_TELEMETRY_QUERY_BASE_URL=$VITE_TELEMETRY_QUERY_BASE_URL
RUN pnpm api:generate && pnpm build

FROM nginx:1.29-alpine
ENV CONSOLE_LISTEN_PORT=80 \
    BENCHMARK_API_UPSTREAM=http://host.docker.internal:18090 \
    TELEMETRY_QUERY_UPSTREAM=http://host.docker.internal:18080
COPY --from=build /workspace/product/dist /usr/share/nginx/html
COPY product/deploy/nginx.console.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:${CONSOLE_LISTEN_PORT}/ || exit 1
